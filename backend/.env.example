PORT=8080
HOST=0.0.0.0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bankos
DB_USER=bankos
DB_PASSWORD=bankos_secret

# Redis (Idempotency + Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
JWT_SECRET=bankos-super-secret-jwt-key-change-in-production
JWT_EXPIRY_HOURS=24
WEBHOOK_SIGNING_SECRET=bankos-webhook-hmac-secret

# Rate Limiting
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
TX_RATE_LIMIT_MAX=60
TX_RATE_LIMIT_WINDOW_SECONDS=60

# Auto-seed demo tenants (banco-andes & cooperativa-sol)
SEED_DEMO_DATA=true
